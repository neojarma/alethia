# Required by Emergent's frontend build-context preparation.
# Alethia uses same-origin /api requests, so no public backend URL is embedded.
REACT_APP_BACKEND_URL=
WDS_SOCKET_PORT=0
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_MODEL=deepseek-v4-flash
AUTH_SECRET=
ALLOWED_ORIGINS=
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1
ENABLE_DEMO_MODE=true
